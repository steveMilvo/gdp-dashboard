# Optional cloud-save backend (Supabase). The game is fully playable as a GUEST
# without any of these set — guest saves use the browser's localStorage.
# Copy this file to ".env" and fill in to enable optional sign-in + cloud saves.
# Setup (table schema, RLS policies, auth redirect URLs): see game/SUPABASE.md.
# Both values are public client-side keys; NEVER put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
