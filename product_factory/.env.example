# Product Factory configuration.
#
# Nothing here is a secret *value* — PF_* vars that name a credential hold a
# reference (`env:NAME`, `file:/path`, `awssm:secret/id`) which the vault
# resolves at the point of use. Copy to `.env` and fill in.

# --- Data residency (Australian entity) --------------------------------------
# Boot fails if this is not an AU region unless PF_ALLOW_OFFSHORE_STORAGE=1.
PF_DATA_REGION=ap-southeast-2
PF_DATABASE_URL=postgresql+psycopg://factory:CHANGEME@db.internal:5432/factory
PF_ARTIFACTS_DIR=/var/lib/product-factory/artifacts
PF_APPS_DIR=/var/lib/product-factory/apps

# --- Public URLs --------------------------------------------------------------
PF_BASE_URL=https://shop.example.com.au
PF_APP_DOMAIN=apps.example.com.au
PF_CURRENCY=AUD

# --- Model ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
PF_ANTHROPIC_KEY_REF=env:ANTHROPIC_API_KEY
PF_MODEL=claude-opus-5
PF_CHEAP_MODEL=claude-haiku-4-5
PF_EFFORT=high
PF_MAX_TOKENS=16000
# Only set if your Anthropic account supports an inference-geography value.
# Left unset, the parameter is not sent.
# PF_INFERENCE_GEO=

# --- Operator console ----------------------------------------------------------
PF_OPERATOR_TOKEN=
PF_OPERATOR_TOKEN_REF=env:PF_OPERATOR_TOKEN

# --- Storefront ----------------------------------------------------------------
# selfhosted | stripe | gumroad
PF_STOREFRONT=selfhosted
PF_SELFHOSTED_WEBHOOK_SECRET=
PF_STRIPE_SECRET_KEY=
PF_STRIPE_WEBHOOK_SECRET=
PF_GUMROAD_ACCESS_TOKEN=
PF_GUMROAD_PING_SECRET=
# Completes checkout without a processor. Never set this in production.
# PF_ALLOW_TEST_CHECKOUT=1

# --- Delivery email ------------------------------------------------------------
PF_SMTP_HOST=
PF_SMTP_PORT=587
PF_SMTP_USER=
PF_SMTP_PASSWORD=
PF_SMTP_FROM=orders@example.com.au

# --- Scraping ------------------------------------------------------------------
PF_USER_AGENT=ProductFactory/1.0 (+https://example.com.au/bot; ops@example.com.au)
PF_SCRAPE_RPM=20
PF_SCRAPE_RETRIES=5
PF_SCRAPE_TIMEOUT=20
PF_RESPECT_ROBOTS=1
# Read captured rows from disk instead of the network. Set for reproducible runs.
# PF_FIXTURES_DIR=/var/lib/product-factory/fixtures
# YOUTUBE_API_KEY=

# --- Publishing ----------------------------------------------------------------
# Per-platform webhook bridges. Unset platforms fall through to the export queue.
# PF_PUBLISH_WEBHOOK_LINKEDIN=https://bridge.internal/linkedin
# PF_PUBLISH_TOKEN_LINKEDIN=
